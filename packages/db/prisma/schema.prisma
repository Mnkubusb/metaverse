// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Layer {
  floor
  wall
  objects
  topObjects
}

model User {
  id          String        @id @unique @default(cuid())
  username    String        @unique
  password    String
  avatarId    String?
  role        Role
  spaces      Space[]
  messages    ChatMessage[]
  memberships SpaceMember[]
  avatar      Avatar?       @relation(fields: [avatarId], references: [id])
}

model Space {
  id         String          @id @unique @default(cuid())
  name       String
  width      Int
  height     Int
  thumbnail  String?
  // Tile where players appear when they join; null = pick the nearest free tile to the centre
  spawnX     Int?
  spawnY     Int?
  // Private: members only (join with the invite link). Unlisted: anyone with the link.
  // Public: also listed on the Explore page.
  visibility Visibility      @default(Unlisted)
  // Secret part of the invite link; resetting it revokes old links
  inviteCode String          @unique @default(cuid())
  createdAt  DateTime        @default(now())
  creatorId  String
  creator    User            @relation(fields: [creatorId], references: [id])
  elements   spaceElements[]
  messages   ChatMessage[]
  members    SpaceMember[]

  @@index([creatorId])
  @@index([visibility, createdAt])
}

model SpaceMember {
  spaceId  String
  userId   String
  role     SpaceRole @default(Member)
  joinedAt DateTime  @default(now())
  space    Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([spaceId, userId])
  @@index([userId])
}

enum Visibility {
  Private
  Unlisted
  Public
}

enum SpaceRole {
  Owner
  Member
}

model ChatMessage {
  id        String   @id @default(cuid())
  spaceId   String
  // null once the author's account is deleted; the message stays in the history
  authorId  String?
  body      String
  createdAt DateTime @default(now())
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([spaceId, createdAt])
}

model spaceElements {
  id        String  @id @unique @default(cuid())
  elementId String
  spaceId   String
  x         Int
  y         Int
  space     Space   @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  element   Element @relation(fields: [elementId], references: [id])

  @@index([spaceId])
  @@index([elementId])
}

model Element {
  id          String          @id @unique @default(cuid())
  width       Int
  height      Int
  static      Boolean
  imageUrl    String
  layer       Layer
  spaces      spaceElements[]
  mapElements mapElements[]
}

model Map {
  id          String        @id @unique @default(cuid())
  width       Int
  height      Int
  name        String
  thumbnail   String
  spawnX      Int?
  spawnY      Int?
  mapElements mapElements[]
}

model mapElements {
  id        String  @id @unique @default(cuid())
  mapId     String
  elementId String
  x         Int
  y         Int
  map       Map     @relation(fields: [mapId], references: [id], onDelete: Cascade)
  element   Element @relation(fields: [elementId], references: [id])

  @@index([mapId])
}

model Avatar {
  id       String  @id @unique @default(cuid())
  imageUrl String?
  name     String?
  users    User[]
}

enum Role {
  Admin
  User
}
