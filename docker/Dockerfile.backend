FROM node:22-alpine

# Prisma's query engine needs OpenSSL on Alpine
RUN apk add --no-cache openssl && npm i -g pnpm@9

WORKDIR /usr/src/app

COPY ./packages ./packages
COPY ./pnpm-lock.yaml ./pnpm-lock.yaml
COPY ./pnpm-workspace.yaml ./pnpm-workspace.yaml
COPY ./package.json ./package.json
COPY ./turbo.json ./turbo.json

COPY ./apps/http ./apps/http

RUN pnpm install --frozen-lockfile \
 && pnpm db:generate \
 && pnpm --dir apps/http run build

ENV NODE_ENV=production
EXPOSE 3000
USER node

# DATABASE_URL, JWT_SECRET and ALLOWED_ORIGIN come from the environment at `docker run`
CMD ["node", "apps/http/dist/index.js"]
